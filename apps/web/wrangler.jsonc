// Cloudflare Workers config for the open-assets.dev marketing site.
//
// Static export: `next build` writes out/ and wrangler uploads it. A thin
// Worker (custom-worker.ts) sits in front for agent markdown negotiation.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Resource naming convention: <project>-<app>-<environment>.
  "name": "open-assets-web-production",
  // Thin Worker in front of the static export, only for agents: markdown
  // negotiation and the discovery Link header (custom-worker.ts).
  "main": "custom-worker.ts",
  "compatibility_date": "2026-08-01",
  // No nodejs_compat: custom-worker.ts is a plain fetch handler over static
  // assets and imports no Node built-ins.
  // Workers AI, only for toMarkdown (free for HTML conversion).
  "ai": { "binding": "AI" },
  // Newsletter subscribers (lib/newsletter-api.ts). The database is declared
  // in program/index.ts (NewsletterDb); after its first `pulumi up`, replace
  // this placeholder id with the `newsletterDbId` stack output. Schema lives in
  // migrations/, applied with `wrangler d1 migrations apply DB --remote`.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "open-assets-web-db-production",
      "database_id": "c5b25e16-fdf0-47a9-828b-cfc169a6a303",
      "migrations_dir": "migrations"
    }
  ],
  "assets": {
    "directory": "out",
    "binding": "ASSETS",
    // Every page path runs the Worker first so Accept: text/markdown can be
    // honoured; content-hashed bundles and images skip it.
    "run_worker_first": ["/*", "!/_next/static/*", "!/img/*"],
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // Custom Domains create the DNS records and certificates on deploy. www is
  // 301'd to the apex by a zone Redirect Rule (program/index.ts, WwwRedirect),
  // so it must stay attached here. workers_dev and preview_urls are off so crawlers only ever
  // see the canonical origin.
  "routes": [
    { "pattern": "open-assets.dev", "custom_domain": true },
    { "pattern": "www.open-assets.dev", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false,
  // Logs and traces ship to the fleet Grafana Cloud destinations.
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
    "logs": { "enabled": true, "invocation_logs": true, "destinations": ["grafana-logs"] },
    "traces": { "enabled": true, "destinations": ["grafana-traces"] }
  }
}
