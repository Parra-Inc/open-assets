// Cloudflare Workers config for docs.open-assets.dev (Fumadocs).
//
// Static assets only: `next build` exports the docs to out/ (search index,
// OG cards and llms files included) and wrangler uploads it. No worker script.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Resource naming convention: <project>-<app>-<environment>.
  "name": "open-assets-docs-production",
  "compatibility_date": "2025-12-01",
  "assets": {
    "directory": "out",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // The Custom Domain creates the DNS record and certificate on deploy.
  // workers_dev is off so crawlers only ever see the canonical origin.
  "routes": [{ "pattern": "docs.open-assets.dev", "custom_domain": true }],
  "workers_dev": false,
  "observability": { "enabled": true }
}
