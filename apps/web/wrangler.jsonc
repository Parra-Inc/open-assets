// Cloudflare Workers config for the open-assets.dev marketing site.
//
// Static assets only: `next build` exports the site to out/ and wrangler
// uploads it. There is no worker script, so requests never invoke code.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  // Resource naming convention: <project>-<app>-<environment>.
  "name": "open-assets-web-production",
  "compatibility_date": "2025-12-01",
  "assets": {
    "directory": "out",
    "not_found_handling": "404-page",
    "html_handling": "auto-trailing-slash"
  },
  // Custom Domains create the DNS records and certificates on deploy. www is
  // 301'd to the apex by a zone Redirect Rule (program/index.ts, WwwRedirect),
  // so it must stay attached here. workers_dev is off so crawlers only ever
  // see the canonical origin.
  "routes": [
    { "pattern": "open-assets.dev", "custom_domain": true },
    { "pattern": "www.open-assets.dev", "custom_domain": true }
  ],
  "workers_dev": false,
  "observability": { "enabled": true }
}
