{
  "version": 1,
  "name": "Open Assets PH Launch",
  "command": "npx open-assets render marketing/launches/product-hunt --output marketing/launches/product-hunt/exports",
  "collections": [
    {
      "id": "gallery",
      "label": "Product Hunt Gallery",
      "sourceSize": { "width": 1270, "height": 760 },
      "borderRadius": 8,
      "templates": [
        { "src": "screenshots/01-hero.html", "name": "01-hero", "label": "Hero" },
        { "src": "screenshots/02-dev-server.html", "name": "02-dev-server", "label": "Dev Server" },
        { "src": "screenshots/03-fan-out.html", "name": "03-fan-out", "label": "Fan Out" },
        { "src": "screenshots/04-localization.html", "name": "04-localization", "label": "Localization" },
        { "src": "screenshots/05-agent-ci.html", "name": "05-agent-ci", "label": "Agent and CI" }
      ],
      "export": [
        { "name": "ph-2x", "label": "PH Gallery 2x", "size": { "width": 2540, "height": 1520 } },
        { "name": "ph-1x", "label": "PH Gallery 1x", "size": { "width": 1270, "height": 760 } }
      ]
    }
  ]
}
